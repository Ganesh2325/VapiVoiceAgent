# =============================================================================
# VoiceOS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=voiceos
POSTGRES_USER=voiceos
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=jdbc:postgresql://localhost:5433/voiceos
DATABASE_USERNAME=voiceos
DATABASE_PASSWORD=change_me_in_production

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=voiceos_redis_password

# ─── Qdrant (Vector Database) ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=voiceos_qdrant_key
QDRANT_COLLECTION_NAME=voiceos_embeddings

# ─── AI Provider (gemini | groq) ─────────────────────────────────────────────
# Primary provider. The system will gracefully fall back to the secondary.
AI_PROVIDER=gemini

# Google Gemini (free tier via AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (used for RAG / memory vectors)
# Options: gemini (text-embedding-004) | local (requires Ollama)
EMBEDDING_PROVIDER=gemini

# ─── Voice Provider (Vapi is the mandatory voice platform) ───────────────────
VOICE_PROVIDER=vapi

# Vapi Configuration (https://dashboard.vapi.ai)
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# ─── JWT Security ────────────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_characters_please
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Application ─────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# Set to true to use mock implementations for all external APIs.
# Mock data is clearly labeled [MOCK] in responses.
MOCK_EXTERNAL_APIS=true

# ─── External Integrations (optional — use mocks when not configured) ────────
# GitHub (optional — unauthenticated = 60 req/hr, PAT = 5000 req/hr)
GITHUB_TOKEN=

# Google Calendar (optional — requires OAuth 2.0 setup)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# SMTP Email (optional — Gmail SMTP free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Observability ───────────────────────────────────────────────────────────
MANAGEMENT_ENDPOINTS_ENABLED=true

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Webhook Secrets ─────────────────────────────────────────────────────────
WEBHOOK_LIVEKIT_SECRET=
WEBHOOK_GITHUB_SECRET=
WEBHOOK_CALENDAR_SECRET=

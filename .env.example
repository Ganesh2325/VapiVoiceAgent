# =============================================================================
# VoiceOS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER put real credentials into source or example files.
# The backend fails closed if required secrets are missing.
# =============================================================================

# ─── Database (REQUIRED for local PostgreSQL) ────────────────────────────────
POSTGRES_DB=voiceos
POSTGRES_USER=voiceos
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5433/voiceos
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ─── Redis (optional for Phase 1 tests; required when Redis is enabled) ──────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Qdrant (optional / unused by Phase 1 security tests) ────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=voiceos_embeddings

# ─── AI Provider (gemini | groq) ─────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_PROVIDER=gemini

# ─── Voice Provider (Vapi is the mandatory voice platform) ───────────────────
VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_PUBLIC_KEY=

# Fail-closed webhook verification (default true).
# Set VAPI_WEBHOOK_ALLOW_INSECURE_LOCAL=true ONLY for local development without Vapi.
VAPI_WEBHOOK_REQUIRE_SECRET=true
VAPI_WEBHOOK_ALLOW_INSECURE_LOCAL=false

# ─── JWT Security (REQUIRED) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Must be at least 32 characters. Known placeholders are rejected at startup.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Application ─────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev

# ─── Provider modes (Phase 4) ────────────────────────────────────────────────
# Calculator is REAL local arithmetic. Travel/email/WhatsApp/calendar/payment
# stay MOCK. Setting REAL without a real implementation returns UNAVAILABLE —
# the backend will not silently fall back to MOCK.
VOICEOS_PROVIDER_TRAVEL_MODE=MOCK
VOICEOS_PROVIDER_WHATSAPP_MODE=MOCK
VOICEOS_PROVIDER_EMAIL_MODE=MOCK
VOICEOS_PROVIDER_CALENDAR_MODE=MOCK
VOICEOS_PROVIDER_PAYMENT_MODE=MOCK

# true = MOCK LLM/integrations. false = do not treat mock tokens as success.
MOCK_EXTERNAL_APIS=true

# ─── External Integrations (optional) ────────────────────────────────────────
GITHUB_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Observability ───────────────────────────────────────────────────────────
MANAGEMENT_ENDPOINTS_ENABLED=true

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Other webhook secrets (optional) ────────────────────────────────────────
WEBHOOK_GITHUB_SECRET=
WEBHOOK_CALENDAR_SECRET=
